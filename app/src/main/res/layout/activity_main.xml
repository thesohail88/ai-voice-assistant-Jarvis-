<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#03070D"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Command Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#091422"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="STARK CORE // OS v4.2"
                android:textColor="#00E5FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="24/7 STANDBY • NEURAL ENGINE ACTIVE"
                android:textColor="#4DD0E1"
                android:textSize="9sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTogglePersona"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="#132B45"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:text="JARVIS"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Config Bar (Voicemail/SMS Translation & Follow-Up Toggles) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#07111D"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnLangSwitch"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#0F243A"
            android:fontFamily="monospace"
            android:text="LANG: ENGLISH"
            android:textColor="#00E5FF"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnFollowUpToggle"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="#0F243A"
            android:fontFamily="monospace"
            android:text="FOLLOW-UP: ON"
            android:textColor="#00E676"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Center Reactor Interactive Visualizer -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.example.aiassistant.ArcReactorHudView
            android:id="@+id/arcReactorView"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/tvCorePrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="6dp"
            android:fontFamily="monospace"
            android:text="[ TAP CORE / SAY 'JARVIS' / HOLD HEADSET ]"
            android:textColor="#546E7A"
            android:textSize="10sp" />
    </FrameLayout>

    <!-- Live Telemetry Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#091422"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="DIAGNOSTIC TELEMETRY"
            android:textColor="#78909C"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBatteryStat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="PWR: 100%"
                android:textColor="#ECEFF1"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvAudioStat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="MIC: ACTIVE"
                android:textColor="#00E5FF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvNetworkStat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="BT: STANDBY"
                android:textColor="#00E676"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Live Tactical Log Terminal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="8dp"
        android:background="#02050A"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="SYSTEM TERMINAL"
            android:textColor="#37474F"
            android:textSize="9sp" />

        <ScrollView
            android:id="@+id/scrollTerminal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvTerminalLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:text="[SYS] Neural core loaded.\n[SYS] Voicemail/SMS translation module active.\n[SYS] Headset long-press interceptor ready."
                android:textColor="#00E5FF"
                android:textSize="10sp" />
        </ScrollView>
    </LinearLayout>

    <!-- Execution Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStartService"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#00E5FF"
            android:fontFamily="monospace"
            android:text="ACTIVATE CORE"
            android:textColor="#03070D"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPermissions"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="#0F243A"
            android:fontFamily="monospace"
            android:text="CHECK ACCESS"
            android:textColor="#ECEFF1"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
