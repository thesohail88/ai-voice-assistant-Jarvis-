<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#02060D"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Command Console -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#091524"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="STARK CORE // OS v5.2"
                android:textColor="#00E5FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="24/7 ACTIVE • SMS/VOICEMAIL ARMED"
                android:textColor="#00E676"
                android:textSize="9sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTogglePersona"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="#122C4A"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:text="JARVIS"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Language, Headset & Rules Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#07111D"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/btnDefaultLangSwitch"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="#0E2338"
            android:fontFamily="monospace"
            android:text="DEF: ENG"
            android:textColor="#00E5FF"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnManageContactLangs"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="#1B3E5C"
            android:fontFamily="monospace"
            android:text="RULES (0)"
            android:textColor="#00E676"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnTestVoiceSample"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1.2"
            android:background="#1B2838"
            android:fontFamily="monospace"
            android:text="TEST VOICE"
            android:textColor="#00E5FF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Arc Reactor Interactive Visualizer -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="130dp">

        <com.example.aiassistant.ArcReactorHudView
            android:id="@+id/arcReactorView"
            android:layout_width="125dp"
            android:layout_height="125dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Interactive Live Chat Window -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#010408"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="TACTICAL NEURAL CHAT &amp; EVENT FEED"
            android:textColor="#546E7A"
            android:textSize="9sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/scrollChat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvChatFeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:text="[JARVIS]: All neural systems operational, sir. How may I assist you today?"
                android:textColor="#00E5FF"
                android:textSize="11sp" />
        </ScrollView>

        <!-- Chat Input Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etChatInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#091524"
                android:fontFamily="monospace"
                android:hint="Type directive to Jarvis..."
                android:inputType="text"
                android:paddingHorizontal="10dp"
                android:textColor="#ECEFF1"
                android:textColorHint="#455A64"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSendChat"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:background="#00E5FF"
                android:fontFamily="monospace"
                android:text="SEND"
                android:textColor="#02060D"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStartService"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#00E5FF"
            android:fontFamily="monospace"
            android:text="ACTIVATE CORE"
            android:textColor="#02060D"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPermissions"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="#0E2338"
            android:fontFamily="monospace"
            android:text="CHECK ACCESS"
            android:textColor="#ECEFF1"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
