<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B14"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="STARK CORE // OS v4.2"
                android:textColor="#00E5FF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="SYSTEM ONLINE • 24/7 STANDBY"
                android:textColor="#00B0FF"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTogglePersona"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="#10253F"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:text="MODE: JARVIS"
            android:textColor="#00E5FF"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="#163758" />

    <!-- SMS / Voicemail Language Selector Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0A1626"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="VOICEMAIL / SMS LANG:"
            android:textColor="#78909C"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLangSwitch"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="#163758"
            android:fontFamily="monospace"
            android:paddingHorizontal="12dp"
            android:text="LANG: ENGLISH"
            android:textColor="#00E5FF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Center Arc Reactor Interactive Core -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/arcReactorContainer"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/tvCorePrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="6dp"
            android:fontFamily="monospace"
            android:text="[ TAP CORE OR SAY 'JARVIS' ]"
            android:textColor="#546E7A"
            android:textSize="11sp" />
    </FrameLayout>

    <!-- Telemetry Diagnostic Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0A1626"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="DIAGNOSTIC TELEMETRY"
            android:textColor="#78909C"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBatteryStat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="PWR: 100%"
                android:textColor="#ECEFF1"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvAudioStat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="MIC: ACTIVE"
                android:textColor="#00E5FF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvNetworkStat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="LAN: SECURE"
                android:textColor="#00E676"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Real-Time Activity Terminal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="8dp"
        android:background="#030810"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="LIVE EVENT LOG"
            android:textColor="#37474F"
            android:textSize="10sp" />

        <ScrollView
            android:id="@+id/scrollTerminal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvTerminalLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:text="[SYS] Live neural core loaded.\n[SYS] Voicemail/SMS Translation module ready.\n[SYS] Standing by..."
                android:textColor="#00E5FF"
                android:textSize="11sp" />
        </ScrollView>
    </LinearLayout>

    <!-- Bottom Command Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStartService"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#00E5FF"
            android:fontFamily="monospace"
            android:text="ACTIVATE CORE"
            android:textColor="#050B14"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPermissions"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="#163758"
            android:fontFamily="monospace"
            android:text="CHECK ACCESS"
            android:textColor="#ECEFF1" />
    </LinearLayout>

</LinearLayout>
